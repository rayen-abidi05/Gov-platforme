// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  
}

datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}



enum exportType {
  liste1
  liste2
}

enum RegionStatus {
  UE
  AMERICA
  MIDDLE_EAST
}
enum ExportRequestStatus {
  SENT
  UNDER_COMMITTEE_REVIEW
  APPROVED
  REJECTED
}
enum UserStatus {
  APPROVED
  REJECTED
}

enum RequestStatus {
  PENDING
  UNDER_REVIEW
  APPROVED
  REJECTED
}
enum Role {
  EXPORTER
  ADMIN
  OBSERVATOR
  DIWAN_MEMBER
  MINISTER  
  INSPA        
}
enum InspectionStatus {
  PENDING
  APPROVED
  REJECTED
}
enum documenttype {
  RNE
  TAXREALTED
  DIWAN
  QUITTANCE
  EXISTANCEDECLARATION
  RENTEDDECLARATION
  CERTIFICATIONOWNERSHIP
  LABDOC
  MARKETCONTROLDECLARATION
  AGRIM              
  CONTRACT          
  MINISTERIAL_LETTER 
}

enum FormulaireStatus {
  PENDING
  APPROVED
  REJECTED
}

model MinisterFormulaire {
  id          String           @id @default(cuid())

  status      FormulaireStatus @default(PENDING)
  requestText String          
  notes       String?          

  submittedAt DateTime         @default(now())
  reviewedAt  DateTime?

  registrationRequestId String              @unique
  registrationRequest   RegistrationRequest @relation(fields: [registrationRequestId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
// =======================
// USER
// =======================

model User {
  id        String      @id @default(cuid())
  name      String
  email     String      @unique
  password  String
  
  role      Role
  status    UserStatus?

  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  company       Company?
  notifications Notification[]
  activityLogs  ActivityLog[]
   instanceMemberships   InstanceMember[]     
  storageInspections    StorageInspection[] 
}

// =======================
// COMPANY
// =======================

model Company {
  id              String   @id @default(cuid())

  commName        String
  rne             String   @unique
  activity        String

  isResident      Boolean

  city            String
  governorate     String

  matFisc         String   @unique

  address         String
  phone           String

  nationality     String

  isRented        Boolean
  registerState   Boolean

  labName         String
  exportType     exportType

  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id])

  registrationRequests RegistrationRequest[]
  exportRequests       ExportRequest[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// =======================
// REGISTRATION REQUEST
// =======================

model RegistrationRequest {
  id          String         @id @default(cuid())

  status      RequestStatus
  notes       String?

  submittedAt DateTime       @default(now())
  reviewedAt  DateTime?

  companyId   String
  company     Company        @relation(fields: [companyId], references: [id])

  documents   Document[]
  ministerFormulaire MinisterFormulaire?
   storageInspection StorageInspection?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
}
// =======================
// AGRIM
// =======================
// One AGRIM certificate can be consumed progressively by multiple exporters,
// each submitting their own ExportRequest against the same reference.
model Agrim {
  id          String   @id @default(cuid())
  reference   String   @unique
  limitKg     Float

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  exportRequests ExportRequest[]
}
// =======================
// EXPORT REQUEST
// =======================

model ExportRequest {
  id            String              @id @default(cuid())

  client        String
  requestedKg   Float

  status        ExportRequestStatus @default(SENT)
  notes         String?

  submittedAt   DateTime            @default(now())
  reviewedAt    DateTime?

  companyId     String
  company       Company             @relation(fields: [companyId], references: [id])

  agrimId       String
  agrim         Agrim               @relation(fields: [agrimId], references: [id])

  documents     Document[]

  instanceId    String?             
  instance      Instance?           @relation(fields: [instanceId], references: [id])

  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
}
// =======================
// INSTANCE — ad-hoc committee reviewing one export request
// =======================
// Not a standing body: created fresh per review session, with whichever
// members actually attended that particular meeting.
model Instance {
  id              String    @id @default(cuid())

  meetingDate     DateTime  @default(now())

 
  reportFileUrl   String?

  internalNotes   String?   
  exportRequests  ExportRequest[] 
  members         InstanceMember[]

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}
// =======================
// STORAGE INSPECTION — INSPA's check during registration (non-resident flow)
// =======================
model StorageInspection {
  id                     String            @id @default(cuid())

  registrationRequestId  String            @unique
  registrationRequest    RegistrationRequest @relation(fields: [registrationRequestId], references: [id])

  inspectorId            String
  inspector              User              @relation(fields: [inspectorId], references: [id])

  status                 InspectionStatus  @default(PENDING)
  notes                  String?

  inspectedAt            DateTime?

  createdAt              DateTime          @default(now())
  updatedAt               DateTime         @updatedAt
}
// =======================
// INSTANCE MEMBER — who actually attended a given session
// =======================
model InstanceMember {
  id          String   @id @default(cuid())

  instanceId  String
  instance    Instance @relation(fields: [instanceId], references: [id])

  userId      String
  user        User     @relation(fields: [userId], references: [id])

  createdAt   DateTime @default(now())
}
// =======================
// DOCUMENT
// =======================

model Document {
  id          String   @id @default(cuid())

  fileName    String
  fileType    String
  fileUrl     String
  DocType     documenttype
  size        Int

  uploadedAt  DateTime @default(now())

  registrationRequestId String?
  registrationRequest   RegistrationRequest? @relation(fields: [registrationRequestId], references: [id])

  exportRequestId String?
  exportRequest   ExportRequest? @relation(fields: [exportRequestId], references: [id])
}

// =======================
// NOTIFICATION
// =======================

model Notification {
  id         String   @id @default(cuid())

  title      String
  message    String

  isRead     Boolean  @default(false)

  createdAt  DateTime @default(now())

  userId     String
  user       User     @relation(fields: [userId], references: [id])
}

// =======================
// ACTIVITY LOG
// =======================

model ActivityLog {
  id         String   @id @default(cuid())

  action     String
  entity     String
  entityId   String

  createdAt  DateTime @default(now())

  userId     String
  user       User     @relation(fields: [userId], references: [id])
}