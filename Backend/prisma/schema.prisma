// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  
}

datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}



enum exportType {
  liste1
  liste2
}

enum RegionStatus {
  UE
  AMERICA
  MIDDLE_EAST
}

enum UserStatus {
  APPROVED
  REJECTED
}

enum RequestStatus {
  PENDING
  UNDER_REVIEW
  APPROVED
  REJECTED
}
enum Role {
  EXPORTER
  ADMIN
  OBSERVATOR
  DIWAN_MEMBER
  MINISTER  
  INSPA        
}

enum documenttype {
  RNE
  TAXREALTED
  DIWAN
  QUITTANCE
  EXISTANCEDECLARATION
  RENTEDDECLARATION
  CERTIFICATIONOWNERSHIP
  LABDOC
  MARKETCONTROLDECLARATION   
}

enum FormulaireStatus {
  PENDING
  APPROVED
  REJECTED
}

model MinisterFormulaire {
  id          String           @id @default(cuid())

  status      FormulaireStatus @default(PENDING)
  requestText String          
  notes       String?          

  submittedAt DateTime         @default(now())
  reviewedAt  DateTime?

  registrationRequestId String              @unique
  registrationRequest   RegistrationRequest @relation(fields: [registrationRequestId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
// =======================
// USER
// =======================

model User {
  id        String      @id @default(cuid())
  name      String
  email     String      @unique
  password  String
  
  role      Role
  status    UserStatus?

  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  company       Company?
  notifications Notification[]
  activityLogs  ActivityLog[]
}

// =======================
// COMPANY
// =======================

model Company {
  id              String   @id @default(cuid())

  commName        String
  rne             String   @unique
  activity        String

  isResident      Boolean

  city            String
  governorate     String

  matFisc         String   @unique

  address         String
  phone           String

  nationality     String

  isRented        Boolean
  registerState   Boolean

  labName         String
  exportType     exportType

  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id])

  registrationRequests RegistrationRequest[]
  exportRequests       ExportRequest[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// =======================
// REGISTRATION REQUEST
// =======================

model RegistrationRequest {
  id          String         @id @default(cuid())

  status      RequestStatus
  notes       String?

  submittedAt DateTime       @default(now())
  reviewedAt  DateTime?

  companyId   String
  company     Company        @relation(fields: [companyId], references: [id])

  documents   Document[]
  ministerFormulaire MinisterFormulaire?

  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
}

// =======================
// EXPORT REQUEST
// =======================

model ExportRequest {
  id                  String         @id @default(cuid())

  region              RegionStatus

  destinationCountry  String

  oilType             String

  quantity            Float

  status              RequestStatus

  notes               String?

  submittedAt         DateTime       @default(now())

  companyId           String
  company             Company        @relation(fields: [companyId], references: [id])

  documents           Document[]

  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
}

// =======================
// DOCUMENT
// =======================

model Document {
  id          String   @id @default(cuid())

  fileName    String
  fileType    String
  fileUrl     String
  DocType     documenttype
  size        Int

  uploadedAt  DateTime @default(now())

  registrationRequestId String?
  registrationRequest   RegistrationRequest? @relation(fields: [registrationRequestId], references: [id])

  exportRequestId String?
  exportRequest   ExportRequest? @relation(fields: [exportRequestId], references: [id])
}

// =======================
// NOTIFICATION
// =======================

model Notification {
  id         String   @id @default(cuid())

  title      String
  message    String

  isRead     Boolean  @default(false)

  createdAt  DateTime @default(now())

  userId     String
  user       User     @relation(fields: [userId], references: [id])
}

// =======================
// ACTIVITY LOG
// =======================

model ActivityLog {
  id         String   @id @default(cuid())

  action     String
  entity     String
  entityId   String

  createdAt  DateTime @default(now())

  userId     String
  user       User     @relation(fields: [userId], references: [id])
}